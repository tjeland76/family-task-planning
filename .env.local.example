# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never reference this in client components or anything under app/ that
# runs in the browser bundle — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID keys — generate with `npx web-push generate-vapid-keys`.
# VAPID_PRIVATE_KEY is server-only, same rule as the service role key above.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
